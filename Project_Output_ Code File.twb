  <worksheets>
    <worksheet name='Monthly Sales Trend Bar Line Chart'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontname='Times New Roman' fontsize='12'>This dual-axis chart combines stacked bars and lines to showcase monthly revenue trends and units sold across product categories.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontname='Times New Roman' fontsize='12'>Steps: </run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Times New Roman' fontsize='12'>1. The stacked bars represent the Total Revenue for each product category per month.2. The lines depict Units Sold, overlaying additional information on the same chart.</run>
            <run>Æ&#10;</run>
            <run fontname='Times New Roman' fontsize='12'>3. The dual-axis format ensures both metrics are visible and comparable.</run>
            <run>Æ&#10;</run>
            <run fontname='Times New Roman' fontsize='12'>4. The x-axis represents months (January to September), providing a time-series analysis.</run>
            <run>Æ&#10;</run>
            <run fontname='Times New Roman' fontsize='12'>5. This chart helps identify seasonal trends and the relationship between revenue and units sold.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Online Sales Data' name='federated.0bgxi1l1th6ysg1ausb7n1ubj5bx' />
          </datasources>
          <datasource-dependencies datasource='federated.0bgxi1l1th6ysg1ausb7n1ubj5bx'>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Product Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Total Revenue]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Units Sold]' role='measure' type='quantitative' />
            <column-instance column='[Product Category]' derivation='None' name='[none:Product Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total Revenue]' derivation='Sum' name='[sum:Total Revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Units Sold]' derivation='Sum' name='[sum:Units Sold:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date]' derivation='Month-Trunc' name='[tmn:Date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[none:Product Category:nk]'>
            <groupfilter function='level-members' level='[none:Product Category:nk]' />
          </filter>
          <slices>
            <column>[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[none:Product Category:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[sum:Units Sold:qk]' field-type='quantitative' fold='true' scope='rows' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[none:Product Category:nk]' />
            </encodings>
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[sum:Total Revenue:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <mark-sizing custom-mark-size-in-axis-units='1.0' mark-alignment='mark-alignment-left' mark-sizing-setting='marks-scaling-on' use-custom-mark-size='false' />
            <encodings>
              <color column='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[none:Product Category:nk]' />
            </encodings>
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[sum:Units Sold:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[none:Product Category:nk]' />
            </encodings>
            <trendline enable-confidence-bands='false' enable-instant-analytics='true' enabled='true' exclude-color='false' exclude-intercept='false' fit='linear' />
          </pane>
        </panes>
        <rows>([federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[sum:Total Revenue:qk] + [federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[sum:Units Sold:qk])</rows>
        <cols>[federated.0bgxi1l1th6ysg1ausb7n1ubj5bx].[tmn:Date:qk]</cols>
